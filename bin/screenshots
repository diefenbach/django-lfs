#!/bin/bash
# Take the screenshots of the management interface for the documentation into docs/images/ (see docs/screenshots.py).
# The demo shop includes the add-ons lfs-bulk-prices and lfs-carousel from PyPI. Arguments pick single screenshots
# by name, e.g. bin/screenshots manage_product_data. Needs uv; the first run also
# downloads the headless browser.
set -euo pipefail
cd "$(dirname "$0")/.."
PLAYWRIGHT="playwright>=1.56,<2"
ADDONS=(--with "lfs-bulk-prices>=2,<3" --with "lfs-carousel>=2,<3")
uv run -q --with "$PLAYWRIGHT" playwright install chromium-headless-shell
exec uv run -q --with "$PLAYWRIGHT" "${ADDONS[@]}" python docs/screenshots.py "$@"
